# Copy to .env and edit. The compose file reads from .env automatically.

# --- Nextcloud / MariaDB ---
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-nc
NEXTCLOUD_TRUSTED_DOMAINS=localhost

# --- Detector ---
# Set this to the Slack incoming-webhook URL for your alerts channel.
# Leave empty to run with Slack disabled (alerts will only go to the
# audit log and the dashboard).
SLACK_WEBHOOK_URL=
