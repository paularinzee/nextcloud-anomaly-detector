worker_processes auto;
events { worker_connections 1024; }

http {
    # JSON access log. Fields required by the spec:
    # source_ip, timestamp, method, path, status, response_size.
    log_format hng_json escape=json
        '{'
            '"source_ip":"$remote_addr",'
            '"timestamp":"$time_iso8601",'
            '"method":"$request_method",'
            '"path":"$request_uri",'
            '"status":$status,'
            '"response_size":$body_bytes_sent,'
            '"user_agent":"$http_user_agent",'
            '"xff":"$http_x_forwarded_for"'
        '}';

    # Trust X-Forwarded-For so $remote_addr becomes the real client IP
    # (rather than the upstream proxy / Docker bridge address).
    #
    # IMPORTANT: only trust XFF from known proxies. Trusting 0.0.0.0/0
    # lets any attacker spoof their source IP via a forged XFF header
    # and trivially bypass per-IP bans by rotating it.
    #
    # We trust:
    #   - private RFC1918 + docker default bridge ranges (compose internal hops)
    #   - loopback
    #   - Cloudflare's published edge IP ranges
    #     (https://www.cloudflare.com/ips/) — keep in sync if CF updates them.
    set_real_ip_from 127.0.0.1;
    set_real_ip_from 10.0.0.0/8;
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 192.168.0.0/16;
    # Cloudflare IPv4
    set_real_ip_from 173.245.48.0/20;
    set_real_ip_from 103.21.244.0/22;
    set_real_ip_from 103.22.200.0/22;
    set_real_ip_from 103.31.4.0/22;
    set_real_ip_from 141.101.64.0/18;
    set_real_ip_from 108.162.192.0/18;
    set_real_ip_from 190.93.240.0/20;
    set_real_ip_from 188.114.96.0/20;
    set_real_ip_from 197.234.240.0/22;
    set_real_ip_from 198.41.128.0/17;
    set_real_ip_from 162.158.0.0/15;
    set_real_ip_from 104.16.0.0/13;
    set_real_ip_from 104.24.0.0/14;
    set_real_ip_from 172.64.0.0/13;
    set_real_ip_from 131.0.72.0/22;
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    sendfile on;
    keepalive_timeout 65;
    server_tokens off;

    upstream nextcloud_backend {
        server nextcloud:80;
    }

    # Detector dashboard upstream.
    # Resolves to the Docker host gateway, where the detector listens on :8080.
    # - Local dev:  detector container has port 8080 published on the host
    # - Production: detector runs on `network_mode: host` (see docker-compose.prod.yml)
    # Both paths land on the same address from nginx's point of view.
    upstream detector_dashboard {
        server host.docker.internal:8080;
    }

    # =====================================================================
    # Nextcloud — IP-only access (per spec, Nextcloud must NOT use a domain)
    # =====================================================================
    server {
        listen 80 default_server;
        server_name _;

        access_log /var/log/nginx/hng-access.log hng_json;
        error_log  /var/log/nginx/error.log warn;

        client_max_body_size 1G;

        # Health endpoint — handy for load balancer / smoke tests.
        location = /healthz {
            access_log off;
            add_header Content-Type text/plain;
            return 200 "ok\n";
        }

        location / {
            proxy_pass http://nextcloud_backend;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header X-Forwarded-Host  $host;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
        }
    }

    # =====================================================================
    # Detector dashboard — devops.hng.credianlab.xyz
    # Plain HTTP. Kept on port 80 so Let's Encrypt's HTTP-01 challenge works.
    # After certbot, either:
    #   (a) leave HTTP serving (fine if Cloudflare proxy fronts the domain), OR
    #   (b) uncomment the TLS server block below + redirect HTTP -> HTTPS
    # =====================================================================
    server {
        listen 80;
        server_name devops.hng.credianlab.xyz;

        access_log /var/log/nginx/hng-access.log hng_json;
        error_log  /var/log/nginx/error.log warn;

        # Let's Encrypt webroot challenge (always served over HTTP).
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
            default_type "text/plain";
        }

        location / {
            proxy_pass http://detector_dashboard;
            proxy_http_version 1.1;
            proxy_set_header Host              $host;
            proxy_set_header X-Real-IP         $remote_addr;
            proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection        "";
            proxy_buffering    off;
            proxy_read_timeout 90s;
        }
    }

    # =====================================================================
    # Detector dashboard over TLS — UNCOMMENT after running certbot.
    # =====================================================================
    # server {
    #     listen 443 ssl;
    #     http2 on;
    #     server_name devops.hng.credianlab.xyz;
    #
    #     ssl_certificate     /etc/letsencrypt/live/devops.hng.credianlab.xyz/fullchain.pem;
    #     ssl_certificate_key /etc/letsencrypt/live/devops.hng.credianlab.xyz/privkey.pem;
    #     ssl_protocols       TLSv1.2 TLSv1.3;
    #     ssl_ciphers         HIGH:!aNULL:!MD5;
    #
    #     access_log /var/log/nginx/hng-access.log hng_json;
    #     error_log  /var/log/nginx/error.log warn;
    #
    #     location / {
    #         proxy_pass http://detector_dashboard;
    #         proxy_http_version 1.1;
    #         proxy_set_header Host              $host;
    #         proxy_set_header X-Real-IP         $remote_addr;
    #         proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    #         proxy_set_header X-Forwarded-Proto $scheme;
    #         proxy_set_header Connection        "";
    #         proxy_buffering    off;
    #         proxy_read_timeout 90s;
    #     }
    # }
}
